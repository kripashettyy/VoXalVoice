# Backend API URL
# Local dev  → http://localhost:8000
# Production → your Render service URL e.g. https://vocalvoice-backend.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# Production site URL (used for sitemap, robots.txt, OG metadata)
NEXT_PUBLIC_SITE_URL=https://voxal-voice.vercel.app/

# Brevo transactional email API key
# Get yours at https://app.brevo.com → Settings → API Keys
BREVO_API_KEY=your_brevo_api_key_here
